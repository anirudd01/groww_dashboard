# Choose Authentication Mode: "TOTP" (Recommended - no daily manual re-auth) or "API_KEY"
GROWW_AUTH_MODE=TOTP

# If using TOTP flow:
# GROWW_API_KEY is your TOTP Token generated on Groww Cloud API Keys page
# GROWW_TOTP_SECRET is your TOTP Secret (or manual key from authenticator QR)
GROWW_API_KEY=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here
PYTHONDONTWRITEBYTECODE=1

# If using API Key & Secret flow:
# GROWW_API_SECRET=your_api_secret_here

# Optional: Direct Access Token (if you already have one for today)
# GROWW_ACCESS_TOKEN=your_access_token_here

# --------------------------------------------------------------------------
# Dhan (DhanHQ v2) - preferred market-data provider for the sector heatmap
# Get both from https://dhanhq.co -> Profile -> DhanHQ Trading APIs
# --------------------------------------------------------------------------
# No access token here: the code mints one from TOTP when needed and shares
# it through the shared database data/market.db (market/providers/dhan_session.py).
# DHAN_TOTP_SECRET is the base32 secret shown once under "Setup TOTP".
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# --------------------------------------------------------------------------
# INDmoney (INDstocks API) - free market data for the sector heatmap
# Set up TOTP at https://www.indstocks.com/app/api-trading/access-tokens
# --------------------------------------------------------------------------
# No access token here: the code mints one from TOTP when needed and shares
# it through the shared database data/market.db
# (market/providers/indmoney_session.py). A new token revokes the previous
# one, so never paste one here as well. IND_MONEY_CLIENT_ID is the Client ID
# the page shows after TOTP setup (sent as x-api-key).
IND_MONEY_CLIENT_ID=
IND_MONEY_MPIN=
IND_MONEY_TOTP_SECRET=
# --------------------------------------------------------------------------
# Zerodha Kite Connect - optional market-data provider for the sector heatmap
# Both from https://developers.kite.trade/apps. Market data needs the paid
# Kite Connect plan. The access token comes from a browser login that must be
# repeated every morning (tokens die at 06:00 IST):
#     python scripts/kite_login.py
# which saves it to the shared database data/market.db. Read-only: no orders.
# --------------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# KITE_ACCESS_TOKEN=            # optional override for the saved session

# --------------------------------------------------------------------------
# Sector Heatmap dashboard (sector_heatmap_dashboard.py) - all optional
# See docs/SECTOR_HEATMAP.md for the full reference.
# --------------------------------------------------------------------------
# Broker preference order - first one that works wins.
# Known: dhan, indmoney, groww, kite.
# PULSE_MARKET_PROVIDERS=dhan,indmoney,groww,kite
# PULSE_HEATMAP_UNIVERSE=NIFTY50
# PULSE_HEATMAP_SECTOR_ORDER=performance      # or: alphabetical
# PULSE_HEATMAP_COLUMNS=4                     # tiles per row
# PULSE_HEATMAP_AGGREGATION=equal_weight      # or: market_cap
# PULSE_HEATMAP_WEIGHTS_DB=                   # blank = the shared data/market.db
# PULSE_HEATMAP_HIGHLIGHT_TABLES=true         # leading/lagging sector tables
# PULSE_HEATMAP_HIGHLIGHT_LIMIT=0             # 0 = every qualifying sector
# PULSE_HEATMAP_UI_REFRESH_SECONDS=1.0
# PULSE_HEATMAP_STALE_AFTER_SECONDS=10
# PULSE_HEATMAP_REST_FALLBACK=true            # false = websocket only
# PULSE_HEATMAP_REST_POLL_SECONDS=3.0
# PULSE_HEATMAP_HISTORICAL_PREV_CLOSE=true    # previous close from daily
#                                             # candles outside market hours
# PULSE_STATE_DB=
#   The SQLite database that holds the saved sessions (Dhan, INDmoney, Kite),
#   the clock offset, and the generated instrument ids, weights and F&O list.
#   Blank = data/market.db at the repository root. Holds live tokens: git-ignored.
# PULSE_HEATMAP_PROVIDER=auto
#   Sidebar's starting provider: auto (the order above, with failover), or
#   one broker name to pin the boards to it (no failover).
# PULSE_LOG_LEVEL=INFO
