# Choose Authentication Mode: "TOTP" (Recommended - no daily manual re-auth) or "API_KEY"
GROWW_AUTH_MODE=TOTP

# If using TOTP flow:
# GROWW_API_KEY is your TOTP Token generated on Groww Cloud API Keys page
# GROWW_TOTP_SECRET is your TOTP Secret (or manual key from authenticator QR)
GROWW_API_KEY=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here
PYTHONDONTWRITEBYTECODE=1

# If using API Key & Secret flow:
# GROWW_API_SECRET=your_api_secret_here

# Optional: Direct Access Token (if you already have one for today)
# GROWW_ACCESS_TOKEN=your_access_token_here
